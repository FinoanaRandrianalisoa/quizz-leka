# ==========================================================================
# Quizz Web Madagascar — Backend (.env)
# Copier ce fichier en `.env` et adapter les valeurs.
# ==========================================================================

# Django
SECRET_KEY=change-me-une-cle-secrete-longue
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origines autorisées du frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8443

# Base de données
# PostgreSQL local :  postgres://postgres:postgres@localhost:5432/quizz
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quizz

# Redis (cache, channel layer Channels, broker Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT (secondes)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Mobile Money (webhooks + API)
MOBILE_MONEY_WEBHOOK_SECRET=
MVOLA_API_KEY=
ORANGE_MONEY_API_KEY=
AIRTEL_MONEY_API_KEY=

# OTP (Twilio / Africa's Talking)
OTP_PROVIDER_SID=
OTP_PROVIDER_TOKEN=

# Compte admin créé automatiquement au lancement du backend
BOOTSTRAP_ADMIN_ENABLED=True
BOOTSTRAP_ADMIN_EMAIL=admin@quizz.mg
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_PSEUDO=Admin